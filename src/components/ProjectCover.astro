---
import covers from '../data/project-covers.json';
import { postersOf, posterHoldOf } from '../lib/projects';
import { packQueue } from '../scripts/poster-queue';
interface Props {slug:string;title:string;priority?:boolean}
const {slug,title,priority=false}=Astro.props;
const shots=postersOf(slug,(covers as Record<string,string[]>)[slug]||[]);
const hold=posterHoldOf(slug);
/* Two posters as real images; the rest as one short list the script turns into images when needed. */
const base=`/projects/${slug}/selected/web/`;
const first=shots.slice(0,2);
const queue=packQueue(shots.slice(2),base);
---
<div class:list={['post-cover',`cover-${slug}`]} aria-hidden="true">
 <div class="cover-stack" data-count={shots.length} data-base={base} data-queue={queue||undefined} data-title={title} style={`--poster-hold:${hold}ms`}>{first.map((src,i)=><img class:list={{'is-on':i===0}} src={src} alt={`${title} — design ${i+1}`} width="900" height="1125" loading={i===0?'eager':'lazy'} fetchpriority={priority&&i===0?'high':undefined} decoding="async" />)}</div>
</div>
<style>
 .post-cover{position:absolute;inset:0;overflow:hidden;background:#edf1f8}.cover-mat{background:#f4e9e9}.cover-exploremorocco{background:#eaf1eb}.cover-justfit{background:#eeeef1}.cover-vanysis{background:#e4f1f1}.cover-dr-majed-mikhail{background:#f3efeb}.cover-is-nutrition{background:#f2eee3}.cover-e-botola{background:#e8f1f8}.cover-morocco-travel{background:#eaf2f7}.cover-maalem{background:#0c1b2e}
 .cover-stack{position:absolute;inset:0}
 .cover-stack img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0}
 .cover-stack img.is-on{opacity:1}
 @media(prefers-reduced-motion:no-preference){.cover-stack img{transition:opacity var(--poster-fade) ease-in-out}}
</style>
<script>
 import { unpackQueue } from '../scripts/poster-queue';
 const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
 document.querySelectorAll<HTMLElement>('.cover-stack').forEach((stack)=>{
  const shots=Array.from(stack.querySelectorAll('img'));
  const queue=unpackQueue(stack.dataset.queue,stack.dataset.base||'');
  const total=shots.length+queue.length;
  if(total<2)return;
  const hold=parseFloat(getComputedStyle(stack).getPropertyValue('--poster-hold'))||4000;
  /* Clone the first image so new ones keep the component's scoped styles. */
  const imageAt=(n:number)=>{
   while(shots.length<=n&&shots.length<total){
    const img=shots[0].cloneNode() as HTMLImageElement;
    img.classList.remove('is-on');
    img.removeAttribute('fetchpriority');
    img.removeAttribute('loading');
    img.alt=`${stack.dataset.title} — design ${shots.length+1}`;
    img.src=queue[shots.length-(total-queue.length)];
    stack.appendChild(img);
    shots.push(img);
   }
   return shots[n];
  };
  let index=0,timer=0;
  const step=()=>{
   index=(index+1)%total;
   imageAt(index);
   shots.forEach((el,i)=>el.classList.toggle('is-on',i===index));
   imageAt((index+1)%total);
  };
  let onScreen=false;
  const start=()=>{if(!timer&&onScreen&&!document.hidden&&!reduce.matches)timer=window.setInterval(step,hold);};
  const stop=()=>{if(timer){clearInterval(timer);timer=0;}};
  new IntersectionObserver((entries)=>{entries.forEach((entry)=>{onScreen=entry.isIntersecting;onScreen?start():stop();});},{rootMargin:'120px',threshold:0}).observe(stack);
  document.addEventListener('visibilitychange',()=>document.hidden?stop():start());
 });
</script>
