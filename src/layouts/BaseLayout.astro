---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /* Share image, relative to the site root. Defaults to the site-wide card. */
  image?: string;
  /* Extra structured data for this page (breadcrumbs, project, business). */
  schema?: object[];
  /* Keep a page out of Google, e.g. the 404 page. */
  noindex?: boolean;
}

const {
  title = 'Mohamed Idrissi | Graphic Designer & Creative Director in Morocco',
  description = 'Graphic designer and creative director in Tétouan, Morocco. Brand identity, social media campaigns and video for sports, fitness and lifestyle brands.',
  image = '/og-image.png',
  schema = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.mohamedidrissi.site');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

/* Tells Google who the site belongs to and what he does. Facts only, no claims. */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mohamed Idrissi',
  jobTitle: 'Graphic Designer & Creative Director',
  url: site.href,
  image: new URL('/og-image.png', site).href,
  email: 'mailto:mohamedidrissi205@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Tétouan', addressCountry: 'MA' },
  knowsAbout: ['Brand identity', 'Graphic design', 'Art direction', 'Social media design', 'Video editing', 'AI-assisted production'],
  sameAs: ['https://www.behance.net/Mohamed_Idrissi'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content="Mohamed Idrissi" />
    <!-- Google Search Console ownership check. Keep it, or Google loses access to the site data. -->
    <meta name="google-site-verification" content="7ysLwoc0PhvZTMD4H3EBeM_dtmtaIlXL3M3DiIAV3DU" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mohamed Idrissi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {[person, ...schema].map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
