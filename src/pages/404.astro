---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SketchArrow from '../components/SketchArrow.astro';
import { slugOf } from '../lib/projects';
import '../styles/editorial.css';

/* Lost visitors get a way back into the work, not a dead end. */
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Page not found | Mohamed Idrissi" description="This page doesn’t exist. Back to the work of Mohamed Idrissi, graphic designer in Tétouan, Morocco." noindex>
  <nav class="portfolio-nav page-width" aria-label="Main navigation"><a href="/" aria-label="Mohamed Idrissi home"><img src="/images/brand-icon.svg" width="64" height="44" alt="" /></a><div><a href="/#work">Work</a><a href="/#services">Services</a><a href="/#contact">Let’s talk ↗</a></div></nav>
  <main class="not-found page-width">
    <img class="not-found-mark" src="/images/brand-mark.svg" width="96" height="96" alt="" aria-hidden="true" />
    <p class="not-found-code">404</p>
    <h1>This page wandered off the sketchbook.</h1>
    <p class="not-found-copy">The link may be old or mistyped. The work is still here.</p>
    <a class="round-link" href="/">Back to the homepage <SketchArrow /></a>
    <ul class="not-found-links">
      {projects.map((project) => <li><a href={`/work/${slugOf(project.id)}/`}>{project.data.title}</a></li>)}
    </ul>
  </main>
</BaseLayout>

<style>
  .not-found { display: flex; flex-direction: column; align-items: flex-start; gap: var(--stack-m); padding-block: var(--section-space); }
  .not-found-mark { width: 4rem; height: auto; }
  .not-found-code { margin: 0; font-family: var(--font-mono); font-size: var(--size-label); letter-spacing: .12em; color: var(--blue); }
  .not-found h1 { max-width: 16ch; font-size: var(--heading-medium); font-weight: 700; letter-spacing: -.045em; line-height: 1.02; }
  .not-found-copy { margin: 0; max-width: 36ch; color: var(--ink-soft); line-height: 1.5; }
  .not-found-links { display: flex; flex-wrap: wrap; gap: var(--stack-s) var(--stack-m); margin: var(--stack-m) 0 0; padding: var(--stack-m) 0 0; border-top: 1px solid var(--line); list-style: none; font-size: var(--size-ui); }
  .not-found-links a { color: var(--ink-soft); text-decoration: none; }
  .not-found-links a:hover { color: var(--blue); }
</style>
